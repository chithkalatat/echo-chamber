# MongoDB Connection
MONGO_URI=mongodb://mongo:27017/echochamber

# JWT Secret for Auth
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Connection (Internal Docker Network)
REDIS_URL=redis://redis:6379

# Google OAuth 2.0 (optional — needed for "Login with Google")
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Email Configuration (optional — falls back to Console/UI logs if blank)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

